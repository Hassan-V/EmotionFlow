# EmotionFlow - Environment Configuration
# Copy to .env and fill in real values

# ─── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://emotionflow:CHANGE_ME@localhost:5433/emotionflow
SYNC_DATABASE_URL=postgresql+psycopg2://emotionflow:CHANGE_ME@localhost:5433/emotionflow
# DB_PASSWORD is used by docker-compose.prod.yml for Postgres container
DB_PASSWORD=CHANGE_ME

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ─── Security ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME

# Shared secret between API and worker (generate with: openssl rand -hex 32)
WORKER_SECRET=CHANGE_ME

# ─── AI / Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Deployment ─────────────────────────────────────────────────
ENVIRONMENT=production
DOMAIN=your-domain.com

# Comma-separated CORS origins (overrides localhost defaults)
CORS_ORIGINS=https://your-domain.com

# Upload directory (defaults to ./uploads)
# UPLOAD_DIR=/app/uploads

# ─── Worker (set on the worker machine) ─────────────────────────
# Point to VPS's Tailscale IP for remote worker
# API_BASE_URL=http://100.x.y.z:8000
# SYNC_DATABASE_URL=postgresql+psycopg2://emotionflow:CHANGE_ME@100.x.y.z:5433/emotionflow
# REDIS_URL=redis://100.x.y.z:6380/0

# JWT — CHANGE THIS IN PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=your-production-secret-here

# Gemini API (for causal reasoning)
GEMINI_API_KEY=

# Limits
# MAX_UPLOAD_SIZE_MB=50
# RATE_LIMIT_PER_MINUTE=30
